# Supabase transaction-pooler connection string, copied from its Connect dialog.
# Use the same project as the collector, with server database permissions.
DATABASE_URL=
# Optional PEM certificate if your database connection needs a custom CA.
DATABASE_CA_CERT=
# Initial workspace password. At least 10 characters; set privately in Vercel.
# This seeds the account on first login; later changes use Settings.
WORKSPACE_PASSWORD=
# Optional names; use a different ID if sharing a database across workspaces.
WORKSPACE_ID=permitline-owner
WORKSPACE_NAME=Your workspace
# Collector origin. Leave empty to use the clearly marked sample records.
PERMIT_API_URL=
PERMIT_API_TOKEN=
# Optional Jev provider key; leave empty until ready.
TYPESAFE_API_KEY=
